# tool-router configuration template.
# Copy to `.env` (gitignored) or export as environment variables.
# Preferred setup paths: `tool-router init` (terminal wizard) or the /setup form.
# NEVER commit a real key — committed credentials are a disqualification trigger.

# --- Generation LLM provider (planner + conditional HyDE + optional enrichment) ---
# Default is "none": the engine is fully functional offline with zero external calls.
TOOL_ROUTER_LLM_PROVIDER=none               # none (default) | gemini (live-verified) | bedrock (implemented, NOT live-tested)

# --- Google Gemini (recommended if you want an LLM — live-verified) ---
# GEMINI_API_KEY=__put_your_key_here__
# TOOL_ROUTER_LLM_MODEL=gemini-flash-lite-latest    # reliable structured JSON output
# TOOL_ROUTER_EMBEDDING_PROVIDER=gemini              # gemini-embedding-001 (optional; local TF-IDF is the tuned default)

# --- AWS Bedrock (implemented, NOT live-tested end-to-end — use Gemini if unsure) ---
# AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=__put_your_key_here__
# Or classic AWS credentials instead of the bearer token:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# TOOL_ROUTER_LLM_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0
# TOOL_ROUTER_EMBEDDING_PROVIDER=bedrock             # amazon.titan-embed-text-v2:0

# --- Embedding provider (retrieval vectors) ---
TOOL_ROUTER_EMBEDDING_PROVIDER=local         # local (default, deterministic TF-IDF) | gemini | bedrock

# --- One-time LLM ingest enrichment (only used if an LLM provider is set above) ---
# Default OFF: measured to blur near-duplicate tools in testing (see docs/eval_report.md).
# TOOL_ROUTER_LLM_ENRICH=off

# --- Engine tuning (defaults are sensible; override only if needed) ---
# TOOL_ROUTER_DATA_DIR=                      # override data directory (default: platformdirs)
# TOOL_ROUTER_LOG_LEVEL=INFO
# TOOL_ROUTER_MAX_WIDEN_ROUNDS=1             # bounded shortlist-widening re-plans
# TOOL_ROUTER_REBUILD=1                      # wipe the embedding/enrichment cache and rebuild
# TOOL_ROUTER_FLOOR=0.18                     # out-of-scope confidence floor
# TOOL_ROUTER_SHORTLIST_RATIO=0.55           # dynamic-K shortlist cutoff (fraction of top score)
# TOOL_ROUTER_SHORTLIST_MAX=8                # max candidates handed to the LLM planner
# TOOL_ROUTER_W_DENSE=0.45                   # fused-score weight: dense/embedding similarity
# TOOL_ROUTER_W_BM25=0.45                    # fused-score weight: BM25 lexical overlap
# TOOL_ROUTER_W_CAPABILITY=0.10              # fused-score weight: capability-token match
